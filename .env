# VITE prefix needed for Vite to load these variables

## BACKEND
# PORT
VITE_WS_PORT=8080
# WEBSOCKET RECONNECT INTERVAL IN MS
VITE_WS_RECONNECT_INTERVAL=5000

## SERIAL
# DEFAULT SERIAL BAUDRATE
VITE_DEFAULT_BAUDRATE=9600

## PLOTTING
# MAX DATA POINTS TO STORE FOR PLOTTING/TELEMETRY
VITE_MAX_DATA_POINTS=50

## TESTING
# ENABLES FAKE TELEMETRY PACKETS
VITE_TESTING_MODE=FALSE
# FREQUENCY OF FAKE TELEMETRY PACKETS IN HZ
VITE_PACKET_FREQUENCY=10
# COM PAIR FOR TESTING MODE (E.G. COM2 IF COM1 IS USED BY THE GSUI)
VITE_TESTING_COM_PAIR=COM2
# BAUDRATE FOR THE TESTING COM PORT
VITE_TESTING_COM_BAUDRATE=9600
